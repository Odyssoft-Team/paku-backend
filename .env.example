# --- Database ---
DB_HOST=db
DB_PORT=5432
DB_USER=paku_user
DB_PASSWORD=Paku_Dev_2026_Secure!
DB_NAME=paku_db
DB_SSLMODE=disable
GCS_BUCKET=paku-media-2026
GCS_SIGNED_URL_TTL_SECONDS=300
# --- App ---
ROOT_PATH=/paku/api/v1
ENV=development
# Push: expo = envía push reales (Expo) | mock = solo log. Sin valor: expo en production, mock en el resto.
PUSH_PROVIDER=mock
# Llave Fernet para cifrar credenciales de integraciones (Resend). Generar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=
STREAMING_SECRET=7e9d4f2a8b6c1e3d7f5a9c2b4d6e8f1a39f4c2e3a8b7d1f6c4a2e9d8f3b1c6a
GOOGLE_ROUTES_API_KEY=AIzaSyCP8NhD7R-g5J81DR-_ZUr_WWx7OpQasaA
# --- Registro con DNI (feature 0027) ---
# true cuando paku-web y la app pidan el DNI como obligatorio. Apagado: el DNI sigue siendo opcional.
DNI_OBLIGATORIO=false
# Consulta de DNI (autocompletar): límites por usuario y caché en memoria.
DNI_CONSULTAS_POR_HORA=5
DNI_DISTINTOS_POR_DIA=3
DNI_CACHE_HORAS=24
# Datos Perú: consulta de DNI para clientes. Usar la clave de cliente de Paku (solo dni_simple), nunca el token de
# administrador. Sin URL o sin clave, la consulta responde 503. No versionar la clave real.
DATOSPERU_URL=
DATOSPERU_API_KEY=
DATOSPERU_TIMEOUT_SEGUNDOS=5
# HCVet (feature 0028): URL base con /v1 (p. ej. https://hcvet-api.odyssoft.com/v1) y la API Key de Paku (hcv_…),
# solo en el backend. No versionar la clave real. Apagada: se guardan consentimientos y operaciones pendientes sin
# enviarlas. Activarla solo con los textos legales aprobados y un mecanismo de titularidad (ver spec 0028).
HCVET_URL=
HCVET_API_KEY=
HCVET_TIMEOUT_SEGUNDOS=10
HCVET_INTEGRACION_ACTIVA=false
